{
  "name": "bom-dia-equipes-dev",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prepare": "husky",
    "build": "next build --webpack",
    "start": "next start",
    "format": "prettier --write \"src/**/*.tsx\" \"src/**/*.ts\"",
    "next:lint": "eslint src --max-warnings=0",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --max-warnings=0 --fix",
    "test": "jest --maxWorkers=50%",
    "test:bail": "jest --maxWorkers=50% --bail",
    "test:watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand"
  },
  "dependencies": {
    "next": "16.4.3",
    "next-pwa": "5.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/nprogress": "0.2.3",
    "@types/react": "19.3.0",
    "babel-plugin-styled-components": "2.3.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-helpers": "2.0.2",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-styled-components": "7.4.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "webpack": "5.112.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
